{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketNewsRecord v1", "type": "object",
  "required": ["source_id", "source_name", "canonical_url", "title", "candidate_status", "access_status"],
  "properties": {
    "source_id": {"type": "string"}, "source_name": {"type": "string"}, "source_section": {"type": ["string", "null"]}, "source_authority": {"type": ["string", "null"]},
    "external_id": {"type": ["string", "null"]}, "identity_key": {"type": ["string", "null"]},
    "canonical_url": {"type": "string", "format": "uri"}, "title": {"type": "string"}, "summary_raw": {"type": ["string", "null"]},
    "body_text": {"type": ["string", "null"]}, "body_html": {"type": ["string", "null"]}, "source_published_at": {"type": ["string", "null"], "format": "date-time"}, "source_modified_at": {"type": ["string", "null"], "format": "date-time"},
    "candidate_status": {"enum": ["INCLUDE", "EXCLUDE", "AMBIGUOUS"]}, "access_status": {"enum": ["PUBLIC", "PAYWALLED", "ACCESS_LIMITED"]},
    "selection_rule_id": {"type": ["string", "null"]}, "selection_rule_version": {"type": ["string", "null"]}, "selection_reason": {"type": ["string", "null"]}, "selection_evidence": {"type": ["object", "null"]},
    "access_evidence": {"type": ["object", "null"]}, "attachments": {"type": "array", "items": {"type": "object"}},
    "language": {"type": ["string", "null"]}, "fetched_at": {"type": ["string", "null"], "format": "date-time"}, "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "evidence_ref": {"type": ["string", "null"]}, "content_hash": {"type": ["string", "null"]}
  }
}
