# Reference production values for docker-compose.min.yml.
# The minimal Compose file forces ARTIFACT_STORAGE_BACKEND=local itself, so an
# existing standard .env can be used unchanged.
APP_ENV=production
ARTIFACT_STORAGE_BACKEND=local
PUBLIC_APP_URL=https://example.com
CORS_ORIGINS=https://example.com

# Keep the generated secrets from .env private:
# APP_SECRET_KEY=
# ENCRYPTION_MASTER_KEY=
# POSTGRES_PASSWORD=
# DEFAULT_ADMIN_PASSWORD=
