ARG PYTHON_VERSION=3.14.6
FROM python:${PYTHON_VERSION}-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api:/app/apps/worker:/app/packages
RUN python -c "import sys; assert sys.version_info[:2] == (3, 14), sys.version"
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 tesseract-ocr tesseract-ocr-rus && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-document.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt -r requirements-document.txt \
 && python -m pip check \
 && python -c "import torch; assert not torch.cuda.is_available(), torch.version.cuda" \
 && python -c "import docling; print('docling import: OK')" \
 && ! python -m pip freeze | grep -Ei '^(nvidia-|cuda-|cudnn)'
COPY apps/api apps/api
COPY apps/worker apps/worker
COPY packages packages
CMD ["celery", "-A", "worker:celery_app", "worker", "--loglevel=INFO", "-Q", "documents", "--concurrency=2"]
